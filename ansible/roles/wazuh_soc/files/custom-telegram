#!/var/ossec/framework/python/bin/python3
# Intégration Wazuh -> Telegram (HardenWatch)
# Wazuh appelle ce script avec : <fichier_alerte> <api_key=chat_id> <hook_url>
import json
import sys
import urllib.parse
import urllib.request


def main():
    alert_file, chat_id, hook_url = sys.argv[1], sys.argv[2], sys.argv[3]
    with open(alert_file) as f:
        alert = json.load(f)

    rule = alert.get("rule", {})
    agent = alert.get("agent", {})
    data = alert.get("data", {})
    source = data.get("srcip") or data.get("src_ip") or "-"

    text = (
        f"🚨 HardenWatch - alerte niveau {rule.get('level')}\n"
        f"Règle {rule.get('id')} : {rule.get('description')}\n"
        f"Machine : {agent.get('name')} ({agent.get('ip', '-')})\n"
        f"Source : {source}\n"
        f"Date : {alert.get('timestamp')}"
    )
    body = urllib.parse.urlencode({"chat_id": chat_id, "text": text}).encode()
    urllib.request.urlopen(hook_url, data=body, timeout=10)


if __name__ == "__main__":
    main()
